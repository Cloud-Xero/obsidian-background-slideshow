{
	"name": "obsidian-background-slideshow",
	"version": "1.1.0",
	"description": "Background image slideshow with smooth fade transitions for Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@types/node": "^22.20.5",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "14.0.0",
		"jiti": "2.7.0",
		"tslib": "2.8.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.71.1",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"obsidian": "1.14.4"
	}
}
